<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
    <include
        android:id="@+id/include_toolbar"
        layout="@layout/include_toolbar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

     Footer pinned -->
    <LinearLayout
        android:id="@+id/footer_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/app_logo"
            android:contentDescription="App logo"/>

        <TextView
            android:id="@+id/tv_slogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="בכוח יחידת 56"
            android:textSize="12sp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <View
        android:id="@+id/footer_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:alpha="0.15"
        android:background="@color/fg"
        app:layout_constraintBottom_toTopOf="@id/footer_group"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Scrollable content area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollRoot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:padding="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/footer_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header row (NOT a card) -->
            <LinearLayout
                android:id="@+id/required_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_card_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Required Inputs"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSetInputs"
                    style="Widget.Material3.Button.FilledTonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Set"/>
            </LinearLayout>

            <!-- Your existing results card (single card, no nesting) -->
            <include
                style="@style/Widget.LandN.ResultsCard.B"
                android:id="@+id/include_results"
                layout="@layout/include_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"/>

            <!-- Buttons -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/features_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_azimuth"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:text="Azimuth"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn_northing"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.48"
                    app:cornerRadius="10dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_northing"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:text="Northing"
                    app:layout_constraintStart_toEndOf="@id/btn_azimuth"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.48"
                    android:layout_marginStart="12dp"
                    app:cornerRadius="10dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_convert"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:text="Converter"
                    android:layout_marginTop="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn_feature4"
                    app:layout_constraintTop_toBottomOf="@id/btn_azimuth"
                    app:layout_constraintWidth_percent="0.48"
                    app:cornerRadius="10dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_feature4"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:text="Unnamed Feature"
                    android:layout_marginTop="12dp"
                    app:layout_constraintStart_toEndOf="@id/btn_convert"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_northing"
                    app:layout_constraintWidth_percent="0.48"
                    android:layout_marginStart="12dp"
                    app:cornerRadius="10dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_databank"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:text="Data Bank"
                    android:layout_marginTop="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn_distance"
                    app:layout_constraintTop_toBottomOf="@id/btn_convert"
                    app:layout_constraintWidth_percent="0.48"
                    app:cornerRadius="10dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_distance"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:text="Distance\nCalculator"
                    android:layout_marginTop="12dp"
                    app:layout_constraintStart_toEndOf="@id/btn_databank"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_feature4"
                    app:layout_constraintWidth_percent="0.48"
                    android:layout_marginStart="12dp"
                    app:cornerRadius="10dp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>





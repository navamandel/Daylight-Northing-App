<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">





    <!--  -->
    <!--
    app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_inputs"
        app:layout_constraintTop_toTopOf="parent"
     -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Azimuth"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/fg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="12dp" />


    <!-- Side button to open Required Inputs dialog -->
    <Button
        android:id="@+id/btn_inputs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Set Inputs"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:tint="@color/fg"
        app:layout_constraintWidth_percent="0.48"/>

    <include
        android:id="@+id/include_results"
        layout="@layout/include_results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_inputs"
        android:layout_marginTop="12dp"/>


    <!--
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Required inputs: NOT SET"
        android:textSize="14sp"
        android:textColor="@color/fg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        android:layout_marginTop="6dp" />
-->

    <!-- Divider -->
    <!--  -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:alpha="0.2"
        android:background="@color/bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <!-- Buttons grid -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/features_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toTopOf="@id/footer_group"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5">


        <Button
            android:id="@+id/btn_azimuth"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:text="Azimuth Calculation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_northing"
            app:layout_constraintTop_toTopOf="parent"

            app:layout_constraintWidth_percent="0.48"/>

        <Button
            android:id="@+id/btn_northing"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:text="Northing"
            app:layout_constraintStart_toEndOf="@id/btn_azimuth"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.48"/>

        <Button
            android:id="@+id/btn_convert"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:text="Converter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_feature4"
            app:layout_constraintTop_toBottomOf="@id/btn_azimuth"
            android:layout_marginTop="12dp"
            app:layout_constraintWidth_percent="0.48"/>

        <Button
            android:id="@+id/btn_feature4"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:text="Unnamed Feature"
            app:layout_constraintStart_toEndOf="@id/btn_convert"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_northing"
            android:layout_marginTop="12dp"
            app:layout_constraintWidth_percent="0.48"/>

        <Button
            android:id="@+id/btn_databank"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:text="Data Bank"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_distance"
            app:layout_constraintTop_toBottomOf="@id/btn_convert"
            android:layout_marginTop="12dp"
            app:layout_constraintWidth_percent="0.48"/>

        <Button
            android:id="@+id/btn_distance"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:text="Distance Calculator"
            app:layout_constraintStart_toEndOf="@id/btn_databank"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_feature4"
            android:layout_marginTop="12dp"
            app:layout_constraintWidth_percent="0.48"/>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Theme toggle row
    <LinearLayout
        android:id="@+id/theme_toggle_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/features_container"
        app:layout_constraintBottom_toTopOf="@id/footer_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <- Label ->
        <TextView
            android:id="@+id/tv_theme_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dark mode"
            android:textSize="14sp"
            android:textColor="@color/fg"/>

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp"/>

        <- Switch ->
        <Switch
            android:id="@+id/switch_theme"
            android:layout_width="48dp"
            android:layout_height="48dp"
            tools:ignore="UseSwitchCompatOrMaterialXml" />
    </LinearLayout>
    -->


    <View
        android:id="@+id/footer_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/fg"
        android:alpha="0.15"
        app:layout_constraintBottom_toTopOf="@id/footer_group"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp"/>


    <LinearLayout
        android:id="@+id/footer_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">


        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/app_logo"
            android:contentDescription="App logo"/>

        <TextView
            android:id="@+id/tv_slogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="בכוח יחידת 56"
            android:textSize="12sp"
            android:textColor="@color/fg"
            android:layout_marginStart="8dp"/>


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>





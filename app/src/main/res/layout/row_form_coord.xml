<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_marginVertical="8dp"
    android:layout_marginHorizontal="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:text="Enter Values:" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilExCoord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="56dp"
                android:gravity="start|center_vertical"
                style="?attr/textInputStyle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_ex_coord"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNyCoord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="56dp"
                android:gravity="start|center_vertical"
                style="?attr/textInputStyle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_ny_coord"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilZCoord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Z Coordinate"
                android:minHeight="56dp"
                android:gravity="start|center_vertical"
                style="?attr/textInputStyle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_z_coord"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Zone + Hemisphere -->
        <LinearLayout
            android:id="@+id/zone_hemi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            style="?attr/textInputStyle">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilZone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Zone"
                android:minHeight="56dp"
                android:gravity="start|center_vertical">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_zone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hemisphere"/>

                <RadioGroup
                    android:id="@+id/rgHemisphere"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbNorth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="N" />

                    <RadioButton
                        android:id="@+id/rbSouth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="S" />
                </RadioGroup>

                <!--
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_hemi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textOn="N"
                    android:textOff="S"
                    app:showText="true"/>
                    -->
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>




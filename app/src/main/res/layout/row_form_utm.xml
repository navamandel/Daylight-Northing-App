<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp"
    android:layout_marginVertical="8dp"
    android:layout_marginHorizontal="12dp">

    <TextView
        android:id="@+id/tv_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:text="UTM Coordinates"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tilEasting"/>


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEasting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Easting"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tilNorthing"
        app:layout_constraintTop_toBottomOf="@id/tv_label"
        app:layout_constraintHorizontal_chainStyle="spread">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_easting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNorthing"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Northing"
        app:layout_constraintStart_toEndOf="@id/tilEasting"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_label"
        android:layout_marginStart="10dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_northing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilZone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Zone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/hemiGroup"
        app:layout_constraintTop_toBottomOf="@id/tilEasting"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_zone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"/>
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/hemiGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tilZone"
        android:layout_marginStart="10dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:text="Hemisphere"/>

        <!--
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_hemi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOff="S"
            android:textOn="N"
            app:showText="true" />
            -->

        <RadioGroup
            android:id="@+id/rgHemisphere"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbNorth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="N" />

            <RadioButton
                android:id="@+id/rbSouth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S" />
        </RadioGroup>


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>




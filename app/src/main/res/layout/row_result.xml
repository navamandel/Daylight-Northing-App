<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="10dp"
    android:paddingHorizontal="4dp">

    <!-- Label: single line, never wraps -->
    <TextView
        android:id="@+id/tv_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Label"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Value: takes remaining space, wraps to next line(s) -->
    <TextView
        android:id="@+id/tv_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Very long value that should wrap onto multiple lines without affecting the label"
        android:textIsSelectable="true"
        android:gravity="end"
        android:maxLines="10"
        android:breakStrategy="high_quality"
        android:hyphenationFrequency="normal"
        app:layout_constraintStart_toEndOf="@id/tv_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_label"
        app:layout_constraintBottom_toBottomOf="@id/tv_label"
        android:layout_marginStart="12dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>


